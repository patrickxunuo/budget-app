# Public values. These are embedded in the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Privileged Supabase access. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Plaid server configuration. Use sandbox locally and production only after
# your deployment URL, OAuth redirects, and webhook endpoint are configured.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-environment-secret
PLAID_WEBHOOK_URL=https://your-domain.example/api/plaid/webhook

# Generate independent random values with at least 32 characters.
PLAID_TOKEN_ENCRYPTION_KEY=replace-with-a-random-encryption-key
CRON_SECRET=replace-with-a-different-random-cron-secret

# Canonical HTTPS origin for redirects and absolute application URLs.
APP_URL=http://localhost:3000
