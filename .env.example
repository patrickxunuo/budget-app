# Copy this file to .env.local for development, or enter the same variables in
# Vercel for deployment. Values below are placeholders, never usable credentials.

# Public values embedded in the browser bundle. These are identifiers, not secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# SERVER-ONLY — privileged Supabase access that bypasses row-level security.
# Never prefix this variable with NEXT_PUBLIC_ or expose it to a browser/log.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# SERVER-ONLY — Plaid credentials and server integration settings.
# Use sandbox locally. `trial` and `production` both call Plaid's Production API
# and require the corresponding access approval in your own Plaid account.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-environment-secret
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://your-deployment.example/api/plaid/webhook

# SERVER-ONLY — independent random values, each at least 32 characters.
# Keep the token key stable: changing it makes every stored Plaid access token
# undecryptable. Treat rotation as a connection migration: disconnect/relink all
# Items or implement a controlled re-encryption before replacing the old key.
PLAID_TOKEN_ENCRYPTION_KEY=replace-with-32-or-more-random-characters
# CRON_SECRET authenticates only internal scheduled work. Do not reuse any key.
# Rotate it in Vercel and any authorized caller together.
CRON_SECRET=replace-with-a-different-32-character-random-value

# SERVER-ONLY — canonical application origin. Use loopback locally and HTTPS in
# deployment; do not include a trailing slash.
APP_URL=http://localhost:3000

# OPTIONAL, SERVER-ONLY — workspace/account lifecycle notifications only.
# Password recovery uses the custom SMTP provider configured in Supabase Auth;
# these application variables do not configure Supabase recovery delivery.
# Configure both values or neither. Percent-encode special characters in SMTP_URL.
# SMTP_URL=smtps://placeholder-user:placeholder-password@smtp.example.com:465
# SMTP_FROM=Budget App <budget@example.com>

# LOCAL E2E ONLY — deterministic Plaid is rejected unless PLAID_ENV=sandbox,
# APP_URL is loopback, and the process is not a Vercel production deployment.
# Never configure this variable in Vercel.
# PLAID_E2E_PROVIDER=deterministic

# LOCAL E2E SEEDING — `pnpm seed:e2e` creates/reuses this owner, then
# `pnpm seed:e2e:financial` reconciles its deterministic Family dashboard rows.
# Both commands read process values first, then `.env.local`, and refuse hosted
# Supabase URLs. Set a disposable E2E_SEED_PASSWORD only in the untracked local
# environment; CI generates its own value at runtime. Never commit the value.
# E2E_SEED_EMAIL=e2e-owner@budget.local
# `seed:e2e` prints/exports E2E_MANUAL_ENTRY_MEMBER_EMAIL/PASSWORD;
# `seed:e2e:financial` prints/exports E2E_DASHBOARD_MEMBER_EMAIL/PASSWORD.
# Copy the printed assignments into the Playwright process environment for a
# local run; GitHub Actions receives them automatically through GITHUB_ENV.

# PLAYWRIGHT ONLY — comma-separated fixture families that must be provisioned.
# Missing required fixtures fail instead of silently skipping; `all` requires all.
# This test-runner variable is not read by the application runtime.
# E2E_REQUIRED_FIXTURES=plaid,auth-owner,categories
