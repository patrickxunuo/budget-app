# Public values. These are embedded in the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Privileged Supabase access. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Plaid server configuration. Use sandbox locally and production only after
# your deployment URL, OAuth redirects, and webhook endpoint are configured.
# Use trial for Plaid Trial; Trial and production both target Plaid Production.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-environment-secret
PLAID_WEBHOOK_URL=https://your-domain.example/api/plaid/webhook
# E2E only: deterministic adapter is rejected unless APP_URL is loopback and
# PLAID_ENV is sandbox. Never set this in a deployed environment.
# PLAID_E2E_PROVIDER=deterministic

# E2E only: comma-separated fixture families that must be provisioned. A family
# listed here fails its Playwright specs when its credentials are missing,
# instead of skipping them silently; anything not listed still skips. Use `all`
# to demand every family. The suite prints the full inventory at the end of a
# run either way. Families: auth-owner, auth-member, auth-invites, auth-setup,
# auth-expired-session, plaid, plaid-repair, plaid-connection,
# plaid-connection-destructive, categories, categories-transaction, dashboard,
# budgets, budgets-service-cleanup, manual-entries, data-lifecycle,
# data-lifecycle-owner, data-lifecycle-destructive,
# data-lifecycle-workspace-destructive.
#
# `pnpm seed:e2e` provisions plaid, auth-owner, and categories from a single
# seeded owner. dashboard, manual-entries, and plaid-connection additionally
# need financial data or a linked Item, so they take their own dedicated
# variables rather than falling back to the seeded member.
# E2E_REQUIRED_FIXTURES=plaid,auth-owner,categories

# Generate independent random values with at least 32 characters.
PLAID_TOKEN_ENCRYPTION_KEY=replace-with-a-random-encryption-key
CRON_SECRET=replace-with-a-different-random-cron-secret

# Canonical HTTPS origin for redirects and absolute application URLs.
APP_URL=http://localhost:3000

# Optional lifecycle notification mail. Configure both or neither.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=Budget App <budget@example.com>
